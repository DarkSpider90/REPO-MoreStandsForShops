<Project>
  <PropertyGroup>
    <!-- Override either property from the command line when using another local game/reference layout. -->
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(MSBuildThisFileDirectory)..\..\GameAssets\Managed</GameManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(MSBuildThisFileDirectory)..\..\GameAssets\BepInEx\core</BepInExCorePath>
  </PropertyGroup>
</Project>
